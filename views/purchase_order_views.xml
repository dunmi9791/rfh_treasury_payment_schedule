<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend purchase.order form to add Treasury smart button and Queue button -->
    <record id="view_purchase_order_form_treasury" model="ir.ui.view">
        <field name="name">purchase.order.form.treasury</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <!-- Smart button in button_box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_treasury_payments" type="object"
                        class="oe_stat_button" icon="fa-money"
                        invisible="treasury_payment_count == 0">
                    <field name="treasury_payment_count" string="Treasury Payments" widget="statinfo"/>
                </button>
            </xpath>

            <!-- Treasury payment state badge near title -->
            <xpath expr="//field[@name='name']" position="after">
                <field name="treasury_payment_state" widget="badge"
                       decoration-muted="treasury_payment_state == 'not_queued'"
                       decoration-info="treasury_payment_state == 'queued'"
                       decoration-warning="treasury_payment_state == 'scheduled'"
                       decoration-primary="treasury_payment_state == 'partially_paid'"
                       decoration-success="treasury_payment_state == 'paid'"/>
                <field name="rfh_approval_state" widget="badge"
                       decoration-warning="rfh_approval_state in ('to_approve', 'requested')"
                       decoration-success="rfh_approval_state == 'approved'"
                       decoration-danger="rfh_approval_state == 'rejected'"/>
            </xpath>

            <!-- Approval and treasury buttons. Approval is enforced again in Python. -->
            <xpath expr="//header/button[last()]" position="after">
                <field name="rfh_can_approve" invisible="1"/>
                <button name="action_rfh_request_approval" type="object"
                        string="Request Approval"
                        class="btn-primary"
                        groups="purchase.group_purchase_user"
                        invisible="rfh_approval_state not in ('to_approve', 'rejected') or state == 'cancel'"/>
                <button name="action_rfh_approve" type="object"
                        string="Approve"
                        class="btn-primary"
                        groups="rfh_treasury_payment_schedule.group_procurement_director"
                        invisible="not rfh_can_approve or rfh_approval_state not in ('to_approve', 'requested') or state == 'cancel'"/>
                <button name="action_rfh_reject" type="object"
                        string="Reject"
                        class="btn-secondary"
                        groups="rfh_treasury_payment_schedule.group_procurement_director"
                        invisible="not rfh_can_approve or rfh_approval_state not in ('to_approve', 'requested') or state == 'cancel'"/>
                <button name="action_create_treasury_payment_schedule" type="object"
                        string="Queue for Treasury Payment"
                        class="btn-warning"
                        groups="rfh_treasury_payment_schedule.group_treasury_user"
                        invisible="state not in ('purchase','done') or rfh_approval_state != 'approved' or treasury_payment_state in ('queued','scheduled','partially_paid','paid')"/>
            </xpath>

            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <group string="Procurement Approval" name="rfh_po_approval">
                    <group>
                        <field name="rfh_approval_state" widget="badge"
                               decoration-warning="rfh_approval_state in ('to_approve', 'requested')"
                               decoration-success="rfh_approval_state == 'approved'"
                               decoration-danger="rfh_approval_state == 'rejected'"/>
                        <field name="rfh_approval_user_id"/>
                        <field name="rfh_approval_date"/>
                    </group>
                    <group>
                        <field name="rfh_approval_note"/>
                        <field name="rfh_approval_grandfathered" invisible="not rfh_approval_grandfathered"/>
                    </group>
                </group>
            </xpath>

        </field>
    </record>

</odoo>
