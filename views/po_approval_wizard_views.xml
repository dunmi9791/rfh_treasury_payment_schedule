<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_rfh_po_approval_reject_wizard" model="ir.ui.view">
        <field name="name">rfh.po.approval.reject.wizard.form</field>
        <field name="model">rfh.po.approval.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Purchase Order">
                <group>
                    <field name="order_id"/>
                    <field name="reason" placeholder="Why is this purchase order being rejected?"/>
                </group>
                <footer>
                    <button name="action_reject" type="object" string="Reject" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
